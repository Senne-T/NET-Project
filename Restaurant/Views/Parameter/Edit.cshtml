@model Restaurant.ViewModels.Parameter.ParameterViewModel

@{
    ViewData["Title"] = "Parameter bewerken";
}

<h1>Parameter bewerken</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="form-group mb-2">
        <label>Naam (key)</label>
        <input asp-for="Naam" class="form-control" readonly />
    </div>

    <div class="form-group mb-2">
        <label asp-for="Waarde"></label>
        <input asp-for="Waarde" class="form-control" />
        <span asp-validation-for="Waarde" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary mt-2">Opslaan</button>
    <a asp-action="Index" class="btn btn-secondary mt-2">Annuleren</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
