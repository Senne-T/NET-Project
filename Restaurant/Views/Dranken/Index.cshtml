@model MVCDemo.ViewModels.Product.ProductListViewModel

@{
    ViewData["Title"] = "Dranken beheren";
}

<div class="admin-page">

    <!-- header -->
    <div class="admin-hero d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="mb-1 fw-bold">Dranken beheren</h2>
        </div>

        <a class="btn btn-success btn-lg" asp-action="Create">
            <i class="bi bi-plus-lg me-1"></i> Nieuwe drank
        </a>
    </div>

    <!-- table card -->
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Naam</th>
                            <th>Categorie</th>
                            <th>Actief</th>
                            <th>Suggestie</th>
                            <th class="text-end pe-4">Acties</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.Product)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold product-name">
                                    @item.Naam
                                </td>

                                <td>
                                    <span class="badge text-bg-secondary-subtle text-dark px-3 py-2 product-category">
                                        @item.CategorieNaam
                                    </span>
                                </td>

                                <td>
                                    @if (item.Actief)
                                    {
                                        <span class="badge text-bg-success-subtle text-success px-3 py-2">
                                            Actief
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-danger-subtle text-danger px-3 py-2">
                                            Inactief
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (item.IsSuggestie)
                                    {
                                        <span class="badge text-bg-primary-subtle px-3 py-2">
                                            <i class="bi bi-stars me-1"></i> Suggestie
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-light text-muted border px-3 py-2">
                                            —
                                        </span>
                                    }
                                </td>

                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-2 action-buttons">
                                        <a asp-controller="Dranken"
                                           asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-outline-primary btn-sm">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-outline-warning btn-sm">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-outline-danger btn-sm">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
    </div>

</div>
