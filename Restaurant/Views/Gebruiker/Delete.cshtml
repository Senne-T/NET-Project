@using Restaurant.ViewModels.Gebruiker
@model GebruikerDeleteViewModel

@inject UserManager<CustomUser> UserManager
@{
    ViewData["Title"] = "Account verwijderen";
}

<style>
    .delete-container {
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 0;
    }

    .delete-card {
        background: white;
        border-radius: 1rem;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        max-width: 550px;
        width: 100%;
        overflow: hidden;
    }

    .delete-header {
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        color: white;
        padding: 2rem;
        text-align: center;
    }

    .delete-header i {
        font-size: 4rem;
        margin-bottom: 1rem;
        animation: warningPulse 2s ease-in-out infinite;
    }

    @@keyframes warningPulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.7; }
    }

    .delete-header h1 {
        font-size: 1.75rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    .delete-header p {
        margin: 0;
        opacity: 0.95;
    }

    .delete-body {
        padding: 2rem;
    }

    .warning-box {
        background: linear-gradient(135deg, #fff3cd 0%, #fffbea 100%);
        border-left: 4px solid #ffc107;
        padding: 1.5rem;
        border-radius: 0.5rem;
        margin-bottom: 1.5rem;
    }

    .warning-box h5 {
        color: #856404;
        font-weight: 700;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .warning-box ul {
        margin: 0;
        padding-left: 1.5rem;
        color: #856404;
    }

    .warning-box li {
        margin-bottom: 0.5rem;
    }

    .info-section {
        background: #f8f9fa;
        padding: 1.5rem;
        border-radius: 0.5rem;
        margin-bottom: 1.5rem;
    }

    .info-section p {
        margin: 0;
        color: #6c757d;
        line-height: 1.6;
    }

    .action-buttons {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .btn-delete-confirm {
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        border: none;
        color: white;
        font-weight: 600;
        padding: 0.875rem 2rem;
        border-radius: 0.5rem;
        transition: all 0.3s;
        flex: 1;
    }

    .btn-delete-confirm:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(220, 53, 69, 0.3);
        color: white;
    }

    .btn-cancel {
        background: white;
        border: 2px solid #6c757d;
        color: #6c757d;
        font-weight: 600;
        padding: 0.875rem 2rem;
        border-radius: 0.5rem;
        transition: all 0.3s;
        flex: 1;
        text-decoration: none;
        display: inline-block;
        text-align: center;
    }

    .btn-cancel:hover {
        background: #6c757d;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(108, 117, 125, 0.3);
    }

    @@media (max-width: 576px) {
        .action-buttons {
            flex-direction: column;
        }
    }
</style>

<div class="delete-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12">
                <div class="delete-card">
                    <div class="delete-header">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <h1>Account Verwijderen</h1>
                        <p>Deze actie kan niet ongedaan worden gemaakt</p>
                    </div>

                    <div class="delete-body">
                        <div class="warning-box">
                            <h5>
                                <i class="bi bi-shield-exclamation"></i>
                                Let op!
                            </h5>
                            <p class="mb-2"><strong>Wat gebeurt er als u uw account verwijdert?</strong></p>
                            <ul>
                                <li>Al uw persoonlijke gegevens worden permanent verwijderd</li>
                                <li>U kunt niet meer inloggen met dit account</li>
                                <li>Uw reservatiegeschiedenis blijft bewaard (geanonimiseerd)</li>
                                <li>Deze actie kan <strong>NIET</strong> ongedaan worden gemaakt</li>
                            </ul>
                        </div>

                        <div class="info-section">
                            <p>
                                <i class="bi bi-info-circle me-2"></i>
                                <strong>Account deactiveren in plaats van verwijderen?</strong><br>
                                Als u later misschien weer gebruik wilt maken van uw account, kunt u contact opnemen met onze klantenservice.
                            </p>
                        </div>

                        <form asp-action="DeleteConfirmed" method="post">
                            <input type="hidden" asp-for="Id" />
                            @Html.AntiForgeryToken()

                            <p class="text-center mb-3 fw-bold text-danger">
                                Weet u zeker dat u wilt doorgaan?
                            </p>

                            <div class="action-buttons">
                                <a asp-action="Beheren" asp-route-id="@UserManager.GetUserId(User)" class="btn-cancel">
                                    <i class="bi bi-x-circle me-2"></i>Annuleren
                                </a>
                                <button type="submit" class="btn-delete-confirm">
                                    <i class="bi bi-trash me-2"></i>Ja, Account Verwijderen
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
