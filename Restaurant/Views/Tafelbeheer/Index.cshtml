@model Restaurant.ViewModels.Tafel.TafelListViewModel

@{
    ViewData["Title"] = "Tafelbeheer";
}

<div class="admin-page">
    <!-- header -->
    <div class="admin-hero d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="mb-1 fw-bold">Tafels beheren</h2>
            <p class="text-muted mb-0">Overzicht van alle tafels in het restaurant</p>
        </div>

        <a class="btn btn-success btn-lg" asp-action="Create">
            <i class="bi bi-plus-circle me-1"></i> Nieuwe tafel toevoegen
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- table card -->
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Tafelnummer</th>
                            <th>Capaciteit</th>
                            <th>Status</th>
                            <th>QR Code</th>
                            <th class="text-end pe-4">Acties</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Tafels.Any())
                        {
                            @foreach (var tafel in Model.Tafels)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold">
                                        <i class="bi bi-table me-2"></i>@tafel.TafelNummer
                                    </td>
                                    <td>
                                        <i class="bi bi-people me-1"></i>
                                        @tafel.MinAantalPersonen - @tafel.AantalPersonen personen
                                    </td>
                                    <td>
                                        @if (tafel.Actief)
                                        {
                                            <span class="badge text-bg-success-subtle text-success px-3 py-2">
                                                <i class="bi bi-check-circle me-1"></i> Actief
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-secondary-subtle text-secondary px-3 py-2">
                                                <i class="bi bi-x-circle me-1"></i> Inactief
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(tafel.QrBarcode))
                                        {
                                            <i class="bi bi-qr-code me-1"></i>
                                            <span class="text-muted small">@tafel.QrBarcode</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-flex justify-content-end gap-2 action-buttons">
                                            <a asp-action="Details" asp-route-id="@tafel.Id" class="btn btn-outline-primary btn-sm">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@tafel.Id" class="btn btn-outline-warning btn-sm">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@tafel.Id" class="btn btn-outline-danger btn-sm">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    <i class="bi bi-info-circle me-2"></i>Er zijn nog geen tafels aangemaakt.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
