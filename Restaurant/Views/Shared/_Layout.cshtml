<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Restaurant</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Restaurant.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-xl navbar-dark bg-dark shadow-sm sticky-top">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-shop-window me-2"></i>Chez Antoine
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-xl-0">
                        
                        <!-- Klant Sectie - Iedereen kan reserveren en bestellen -->
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Reservatie" asp-action="Index">
                                <i class="bi bi-calendar-check me-1"></i> Reserveren
                            </a>
                        </li>
                        
                        @if (User.IsInRole("Klant") || User.IsInRole("Eigenaar"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Bestelling" asp-action="Menu">
                                    <i class="bi bi-cart3 me-1"></i> Bestellen
                                </a>
                            </li>
                        }
                        
                        @if (User.Identity.IsAuthenticated && (User.IsInRole("Klant") || User.IsInRole("Eigenaar")))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Reservatie" asp-action="MyReservations">
                                    <i class="bi bi-list-check me-1"></i> Mijn Reservaties
                                </a>
                            </li>
                        }
                        
                        @if (User.IsInRole("Kok") || User.IsInRole("Ober") || User.IsInRole("Zaalverantwoordelijke") || User.IsInRole("Eigenaar"))
                        {
                            <!-- Divider -->
                            <li class="nav-item">
                                <span class="nav-link text-muted">|</span>
                            </li>
                        }
                        
                        <!-- Operationeel - Kok, Ober, Zaalverantwoordelijke, Eigenaar -->
                        @if (User.IsInRole("Kok") || User.IsInRole("Eigenaar"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Order" asp-action="Kok">
                                    <i class="bi bi-egg-fried me-1"></i> Keuken
                                </a>
                            </li>
                        }
                        
                        @if (User.IsInRole("Ober") || User.IsInRole("Eigenaar"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Order" asp-action="Ober">
                                    <i class="bi bi-person-badge me-1"></i> Bediening
                                </a>
                            </li>
                        }
                        
                        @if (User.IsInRole("Zaalverantwoordelijke") || User.IsInRole("Eigenaar"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Tafel" asp-action="Index">
                                    <i class="bi bi-grid-3x3 me-1"></i> Tafelbeheer
                                </a>
                            </li>
                        }
                        
                        @if (User.IsInRole("Zaalverantwoordelijke") || User.IsInRole("Eigenaar"))
                        {
                            <!-- Divider -->
                            <li class="nav-item">
                                <span class="nav-link text-muted">|</span>
                            </li>
                        }
                        
                        @if (User.IsInRole("Zaalverantwoordelijke") || User.IsInRole("Kok") || User.IsInRole("Ober") || User.IsInRole("Eigenaar"))
                        {
                            <!-- Beheer Dropdown -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="beheerDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-gear me-1"></i> Beheer
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="beheerDropdown">
                                    @if (User.IsInRole("Kok") || User.IsInRole("Ober") || User.IsInRole("Eigenaar"))
                                    {
                                        <li><h6 class="dropdown-header"><i class="bi bi-box me-2"></i>Producten</h6></li>
                                        
                                        @if (User.IsInRole("Kok") || User.IsInRole("Eigenaar"))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Gerechten" asp-action="Index">
                                                <i class="bi bi-egg me-2"></i> Gerechten
                                            </a></li>
                                            <li><a class="dropdown-item" asp-controller="Desserten" asp-action="Index">
                                                <i class="bi bi-cake2 me-2"></i> Desserten
                                            </a></li>
                                            <li><a class="dropdown-item" asp-controller="Specialiteiten" asp-action="Index">
                                                <i class="bi bi-star me-2"></i> Specialiteiten
                                            </a></li>
                                        }
                                        
                                        @if (User.IsInRole("Ober") || User.IsInRole("Eigenaar"))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Dranken" asp-action="Index">
                                                <i class="bi bi-cup me-2"></i> Dranken
                                            </a></li>
                                        }
                                        
                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    
                                    @if (User.IsInRole("Zaalverantwoordelijke") || User.IsInRole("Eigenaar"))
                                    {
                                        <li><h6 class="dropdown-header"><i class="bi bi-people me-2"></i>Systeem</h6></li>
                                        <li><a class="dropdown-item" asp-controller="Tafel" asp-action="Betalingen">
                                            <i class="bi bi-credit-card me-2"></i> Betalingen
                                        </a></li>
                                    }
                                    
                                    @if (User.IsInRole("Eigenaar"))
                                    {
                                        @if (!User.IsInRole("Zaalverantwoordelijke"))
                                        {
                                            <li><h6 class="dropdown-header"><i class="bi bi-people me-2"></i>Systeem</h6></li>
                                        }
                                        <li><a class="dropdown-item" asp-controller="Gebruikers" asp-action="Index">
                                            <i class="bi bi-person-plus me-2"></i> Gebruikers
                                        </a></li>
                                        <li><a class="dropdown-item" asp-controller="Tafelbeheer" asp-action="Index">
                                            <i class="bi bi-table me-2"></i> Tafels beheren
                                        </a></li>
                                        <li><a class="dropdown-item" asp-controller="Mail" asp-action="Index">
                                            <i class="bi bi-envelope me-2"></i> E-mailsjablonen
                                        </a></li>
                                        <li><a class="dropdown-item" asp-controller="Parameter" asp-action="Index">
                                            <i class="bi bi-sliders me-2"></i> Parameters
                                        </a></li>
                                        
                                        <li><hr class="dropdown-divider"></li>
                                        
                                        <li><a class="dropdown-item" asp-controller="Enquete" asp-action="AlleEvaluaties">
                                            <i class="bi bi-star-half me-2"></i> Evaluaties
                                        </a></li>
                                    }
                                </ul>
                            </li>
                        }
                    </ul>

                    <!-- Right side -->
                    <div class="d-flex align-items-center">
                        @if (User.Identity.IsAuthenticated)
                        {
                            var userName = User.Identity.Name ?? ""; 
                            var displayName = userName.Length > 20 ? userName.Substring(0, 20) + "..." : userName;
                            var userId = @User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                            
                            <a asp-controller="Gebruiker" asp-action="Beheren" asp-route-id="@userId" 
                               class="btn btn-outline-light btn-sm me-2" 
                               title="@userName - Klik om account te beheren">
                                <i class="bi bi-person-circle me-1"></i>@displayName
                            </a>
                        }
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>
    
    <main role="main" id="main-content">
        @RenderBody()
    </main>

    <footer class="bg-dark text-light py-4 mt-5">
        <div class="container-fluid px-4">
            <div class="row">
                <div class="col-md-6">
                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-shop-window me-2"></i>Chez Antoine
                    </h5>
                    <p class="text-muted mb-2">
                        <i class="bi bi-geo-alt me-2"></i>Turnhout, België
                    </p>
                    <p class="text-muted mb-0">
                        <i class="bi bi-clock me-2"></i>Di–Zo 11:30–22:00
                    </p>
                </div>
                <div class="col-md-6 text-md-end">
                    <p class="text-muted mb-2">
                        &copy; 2025 Chez Antoine Restaurant
                    </p>
                    <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-light text-decoration-none">
                        <i class="bi bi-shield-check me-1"></i>Privacy Policy
                    </a>
                </div>
            </div>
        </div>
    </footer>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
