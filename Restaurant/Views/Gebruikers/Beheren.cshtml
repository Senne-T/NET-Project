@using Restaurant.ViewModels.Gebruikers
@model GebruikersEditViewModel

@inject UserManager<CustomUser> UserManager
@{
	ViewData["Title"] = $"Accountdetails beheren";
}

<div class="admin-page">
	<div class="container">
		<div class="mb-4">
			<a asp-action="Index" asp-controller="Gebruikers" class="btn btn-outline-primary">
				<i class="bi bi-arrow-left me-1"></i> Terug naar overzicht
			</a>
		</div>

		<div class="card shadow-sm border-0 rounded-4">
			<div class="card-body p-4">
				<h2 class="fw-bold mb-4">
					<i class="bi bi-person-gear me-2"></i>Accountdetails beheren
				</h2>

				@if (TempData["Error"] != null)
				{
					<div class="alert alert-danger alert-dismissible fade show" role="alert">
						<i class="bi bi-exclamation-triangle-fill me-2"></i>
						@TempData["Error"]
						<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
					</div>
				}

				<form id="beherenForm" asp-controller="Gebruikers" asp-action="Beheren" method="post">
					<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

					<div class="row g-4">
						<div class="col-md-6">
							<h5 class="fw-semibold mb-3 pb-2 border-bottom">
								<i class="bi bi-info-circle me-2"></i>Persoonlijke Informatie
							</h5>

							<div class="mb-3">
								<label asp-for="Emailadres" class="form-label fw-semibold"></label>
								<input asp-for="Emailadres" class="form-control" autocomplete="username" />
								<span asp-validation-for="Emailadres" class="text-danger"></span>
							</div>

							<div class="mb-3">
								<label asp-for="Voornaam" class="form-label fw-semibold"></label>
								<input asp-for="Voornaam" class="form-control" />
								<span asp-validation-for="Voornaam" class="text-danger"></span>
							</div>

							<div class="mb-3">
								<label asp-for="Achternaam" class="form-label fw-semibold"></label>
								<input asp-for="Achternaam" class="form-control" />
								<span asp-validation-for="Achternaam" class="text-danger"></span>
							</div>

							<div class="mb-3">
								<label asp-for="LandId" class="form-label fw-semibold">Land</label>
								<select asp-for="LandId" class="form-select" asp-items="Model.Landen">
									<option value="">Kies land</option>
								</select>
								<span asp-validation-for="LandId" class="text-danger"></span>
							</div>

							<div class="mb-3">
								<label class="form-label fw-semibold">Huidige rollen</label>
								@if (Model.HuidigeRollen != null && Model.HuidigeRollen.Any())
								{
									<div class="list-group">
										@foreach (var rol in Model.HuidigeRollen)
										{
											<div class="list-group-item d-flex align-items-center py-2">
												<i class="bi bi-person-badge me-2 text-primary"></i>
												<span>@rol.Text</span>
											</div>
										}
									</div>
								}
								else
								{
									<p class="text-muted fst-italic mb-0">Geen rollen toegewezen</p>
								}
							</div>
						</div>

						<div class="col-md-6">
							<h5 class="fw-semibold mb-3 pb-2 border-bottom">
								<i class="bi bi-house me-2"></i>Adresgegevens
							</h5>

							<div class="mb-3">
								<label asp-for="Adres" class="form-label fw-semibold"></label>
								<input asp-for="Adres" class="form-control" />
								<span asp-validation-for="Adres" class="text-danger"></span>
							</div>

							<div class="mb-3">
								<label asp-for="Huisnummer" class="form-label fw-semibold"></label>
								<input asp-for="Huisnummer" class="form-control" />
								<span asp-validation-for="Huisnummer" class="text-danger"></span>
							</div>

							<div class="mb-3">
								<label asp-for="Postcode" class="form-label fw-semibold"></label>
								<input asp-for="Postcode" class="form-control" />
								<span asp-validation-for="Postcode" class="text-danger"></span>
							</div>

							<div class="mb-3">
								<label asp-for="Gemeente" class="form-label fw-semibold"></label>
								<input asp-for="Gemeente" class="form-control" />
								<span asp-validation-for="Gemeente" class="text-danger"></span>
							</div>

							<h5 class="fw-semibold mb-3 pb-2 border-bottom mt-4">
								<i class="bi bi-shield-check me-2"></i>Rollenbeheer
							</h5>

							<div class="mb-3">
								<label asp-for="RolVerwijderenId" class="form-label fw-semibold">Rol verwijderen</label>
								<select asp-for="RolVerwijderenId" class="form-select" asp-items="Model.HuidigeRollen">
									<option value="">Kies rol om te verwijderen</option>
								</select>
								<span asp-validation-for="RolVerwijderenId" class="text-danger"></span>
							</div>

							<div class="mb-3">
								<label asp-for="RolToevoegenId" class="form-label fw-semibold">Rol toevoegen</label>
								<select asp-for="RolToevoegenId" class="form-select" asp-items="Model.AlleRollen">
									<option value="">Kies rol om toe te voegen</option>
								</select>
								<span asp-validation-for="RolToevoegenId" class="text-danger"></span>
							</div>
						</div>
					</div>

					<hr class="my-4" />

					<div class="d-flex justify-content-between gap-2">
						<a asp-action="Index" asp-controller="Gebruikers" class="btn btn-outline-secondary">
							<i class="bi bi-x-lg me-1"></i> Annuleren
						</a>
						<button id="beherenSubmit" type="submit" class="btn btn-primary btn-lg">
							<i class="bi bi-check-lg me-1"></i> Opslaan
						</button>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}
