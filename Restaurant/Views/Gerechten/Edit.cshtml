@model Restaurant.ViewModels.ProductEditViewModel

@{
    ViewData["Title"] = "Gerecht bewerken";
}

<div class="admin-page">
    <div class="mb-4">
        <a asp-controller="Gerechten" asp-action="Index" class="btn btn-outline-primary">
            <i class="bi bi-arrow-left me-1"></i> Terug naar overzicht
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">
            <h2 class="fw-bold mb-4">
                <i class="bi bi-pencil-square me-2"></i>Gerecht bewerken
            </h2>

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Naam" class="form-label fw-semibold"></label>
                        <input asp-for="Naam" class="form-control" />
                        <span asp-validation-for="Naam" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CategorieId" class="form-label fw-semibold">Categorie</label>
                        <select asp-for="CategorieId" asp-items="Model.Categorieën" class="form-select">
                            <option value="">Kies een categorie</option>
                        </select>
                        <span asp-validation-for="CategorieId" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Beschrijving" class="form-label fw-semibold"></label>
                        <textarea asp-for="Beschrijving" rows="3" class="form-control"></textarea>
                        <span asp-validation-for="Beschrijving" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="AllergenenInfo" class="form-label fw-semibold"></label>
                        <input asp-for="AllergenenInfo" class="form-control" />
                        <span asp-validation-for="AllergenenInfo" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Prijs" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text">€</span>
                            <input asp-for="Prijs" class="form-control" type="number" step="0.01" lang="en" inputmode="decimal" />
                        </div>
                        <span asp-validation-for="Prijs" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <div class="form-check form-switch mb-2">
                            <input asp-for="Actief" class="form-check-input" role="switch" />
                            <label asp-for="Actief" class="form-check-label fw-semibold"></label>
                        </div>

                        <div class="form-check form-switch">
                            <input asp-for="IsSuggestie" class="form-check-input" role="switch" />
                            <label asp-for="IsSuggestie" class="form-check-label fw-semibold">Suggestie</label>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i> Opslaan
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-lg me-1"></i> Annuleren
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
