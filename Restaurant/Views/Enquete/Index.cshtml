@{
    ViewData["Title"] = "Klanttevredenheid Enquête";
}

<style>
    .survey-hero {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 2rem 0;
        margin-bottom: 2rem;
        border-radius: 0 0 1.5rem 1.5rem;
        text-align: center;
    }

    .survey-hero h1 {
        font-size: 2rem;
        margin-bottom: 0.5rem;
    }

    .survey-hero p {
        font-size: 1rem;
        margin-bottom: 0;
        opacity: 0.95;
    }

    .survey-card {
        background: white;
        border-radius: 1.5rem;
        box-shadow: 0 10px 40px rgba(0,0,0,0.1);
        overflow: hidden;
        margin-bottom: 2rem;
    }

    .survey-body {
        padding: 2rem;
    }

    .survey-question {
        font-size: 1.5rem;
        font-weight: 700;
        color: #2d3748;
        text-align: center;
        margin-bottom: 2rem;
        line-height: 1.4;
    }

    .star-rating-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
        padding: 2rem 1rem;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-radius: 1.5rem;
        margin-bottom: 2rem;
    }

    .star-rating-display {
        display: flex;
        gap: 0.75rem;
        justify-content: center;
    }

    .star-rating-item {
        font-size: 3.5rem;
        cursor: pointer;
        transition: all 0.3s ease;
        color: #dee2e6;
    }

    .star-rating-item:hover {
        transform: scale(1.2) rotate(10deg);
    }

    .star-rating-item.active {
        color: #ffc107;
        animation: starPulse 0.5s ease;
    }

    @@keyframes starPulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.2); }
    }

    .rating-text {
        font-size: 1.25rem;
        font-weight: 600;
        color: #667eea;
        min-height: 2rem;
        text-align: center;
    }

    .rating-description {
        font-size: 0.9rem;
        color: #718096;
        text-align: center;
    }

    .feedback-section {
        background: white;
        padding: 1.5rem;
        border-radius: 1rem;
        border: 2px solid #e9ecef;
    }

    .feedback-section label {
        font-weight: 600;
        color: #2d3748;
        margin-bottom: 0.75rem;
        display: block;
    }

    .feedback-textarea {
        border: 2px solid #e9ecef;
        border-radius: 0.75rem;
        padding: 1rem;
        transition: all 0.3s;
        resize: vertical;
    }

    .feedback-textarea:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        outline: none;
    }

    .btn-submit {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        border: none;
        color: white;
        font-size: 1.25rem;
        font-weight: 600;
        padding: 1rem 3rem;
        border-radius: 0.75rem;
        transition: all 0.3s;
        width: 100%;
    }

    .btn-submit:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 10px 30px rgba(40, 167, 69, 0.3);
        color: white;
    }

    .btn-submit:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .info-banner {
        background: linear-gradient(135deg, #e7f3ff 0%, #f0f9ff 100%);
        border-left: 4px solid #667eea;
        padding: 1.25rem;
        border-radius: 0.75rem;
        margin-bottom: 2rem;
        text-align: center;
    }

    .info-banner i {
        font-size: 2rem;
        color: #667eea;
        margin-bottom: 0.5rem;
    }

    .rating-emoji-container {
        display: flex;
        justify-content: center;
        gap: 1rem;
        margin-top: 1rem;
    }

    .rating-emoji {
        font-size: 3rem;
        opacity: 0;
        transition: all 0.3s;
    }

    .rating-emoji.active {
        opacity: 1;
        animation: emojiPop 0.5s ease;
    }

    @@keyframes emojiPop {
        0% { transform: scale(0); }
        50% { transform: scale(1.2); }
        100% { transform: scale(1); }
    }

    @@media (max-width: 768px) {
        .star-rating-item {
            font-size: 2.5rem;
            gap: 0.5rem;
        }

        .survey-question {
            font-size: 1.25rem;
        }

        .rating-emoji {
            font-size: 2rem;
        }
    }
</style>

<div class="survey-hero">
    <div class="container">
        <h1 class="fw-bold">
            <i class="bi bi-star-fill"></i> Klanttevredenheid
        </h1>
        <p>Uw mening helpt ons om beter te worden</p>
    </div>
</div>

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-4 mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    <strong>@TempData["SuccessMessage"]</strong>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="info-banner">
                <i class="bi bi-heart-fill d-block"></i>
                <strong>Bedankt voor uw bezoek!</strong>
                <p class="mb-0 mt-2">Uw feedback is belangrijk voor ons en helpt ons onze service te verbeteren.</p>
            </div>

            <div class="survey-card">
                <div class="survey-body">
                    <h2 class="survey-question">@ViewBag.SurveyQuestion</h2>

                    <form asp-action="Submit" method="post" id="surveyForm">
                        <input type="hidden" name="reservatieId" value="@ViewBag.ReservatieId" />
                        
                        <div class="star-rating-container">
                            <!-- Hidden radio buttons -->
                            <input type="radio" id="star5" name="score" value="5" style="display: none;" />
                            <input type="radio" id="star4" name="score" value="4" style="display: none;" />
                            <input type="radio" id="star3" name="score" value="3" style="display: none;" />
                            <input type="radio" id="star2" name="score" value="2" style="display: none;" />
                            <input type="radio" id="star1" name="score" value="1" style="display: none;" />
                            
                            <div class="star-rating-display" id="starRating">
                                <i class="bi bi-star star-rating-item" data-rating="1"></i>
                                <i class="bi bi-star star-rating-item" data-rating="2"></i>
                                <i class="bi bi-star star-rating-item" data-rating="3"></i>
                                <i class="bi bi-star star-rating-item" data-rating="4"></i>
                                <i class="bi bi-star star-rating-item" data-rating="5"></i>
                            </div>

                            <div class="rating-emoji-container">
                                <span class="rating-emoji" id="emoji1">&#128542;</span>
                                <span class="rating-emoji" id="emoji2">&#128533;</span>
                                <span class="rating-emoji" id="emoji3">&#128528;</span>
                                <span class="rating-emoji" id="emoji4">&#128522;</span>
                                <span class="rating-emoji" id="emoji5">&#128525;</span>
                            </div>

                            <div class="rating-text" id="ratingText">Klik op de sterren om te beoordelen</div>
                            <div class="rating-description" id="ratingDesc"></div>
                        </div>

                        <div class="feedback-section">
                            <label for="opmerkingen">
                                <i class="bi bi-chat-left-text me-2"></i>
                                Heeft u nog specifieke opmerkingen of suggesties?
                            </label>
                            <textarea class="form-control feedback-textarea" 
                                      id="opmerkingen" 
                                      name="opmerkingen" 
                                      rows="5" 
                                      placeholder="Deel hier uw ervaring, suggesties of wat we kunnen verbeteren..."></textarea>
                            <small class="text-muted mt-2 d-block">
                                <i class="bi bi-info-circle"></i> Optioneel - maar zeer gewaardeerd
                            </small>
                        </div>

                        <button type="submit" class="btn-submit mt-4" id="submitBtn" disabled>
                            <i class="bi bi-send-fill me-2"></i> Verstuur Feedback
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const starItems = document.querySelectorAll('.star-rating-item');
    const ratingText = document.getElementById('ratingText');
    const ratingDesc = document.getElementById('ratingDesc');
    const submitBtn = document.getElementById('submitBtn');
    let currentRating = 0;
    
    const ratingData = {
        1: { text: 'Teleurstellend', desc: 'We betreuren dat u niet tevreden was', emoji: 'emoji1', color: '#dc3545' },
        2: { text: 'Onder verwachting', desc: 'We kunnen beter, vertel ons hoe', emoji: 'emoji2', color: '#fd7e14' },
        3: { text: 'Voldoende', desc: 'Redelijk maar met ruimte voor verbetering', emoji: 'emoji3', color: '#ffc107' },
        4: { text: 'Goed', desc: 'We zijn blij dat u tevreden bent!', emoji: 'emoji4', color: '#20c997' },
        5: { text: 'Uitstekend', desc: 'Geweldig! Bedankt voor deze waardering', emoji: 'emoji5', color: '#28a745' }
    };
    
    function updateStars(rating) {
        // Reset all emojis
        document.querySelectorAll('.rating-emoji').forEach(e => e.classList.remove('active'));
        
        starItems.forEach((star, index) => {
            if (index < rating) {
                star.className = 'bi bi-star-fill star-rating-item active';
            } else {
                star.className = 'bi bi-star star-rating-item';
            }
        });
        
        if (rating > 0) {
            const data = ratingData[rating];
            document.getElementById('star' + rating).checked = true;
            ratingText.textContent = data.text + ' (' + rating + ' ster' + (rating > 1 ? 'ren' : '') + ')';
            ratingText.style.color = data.color;
            ratingDesc.textContent = data.desc;
            
            // Show emoji
            document.getElementById(data.emoji).classList.add('active');
            
            submitBtn.disabled = false;
        } else {
            ratingText.textContent = 'Klik op de sterren om te beoordelen';
            ratingText.style.color = '#667eea';
            ratingDesc.textContent = '';
            submitBtn.disabled = true;
        }
    }
    
    starItems.forEach((star, index) => {
        star.addEventListener('click', function() {
            const rating = index + 1;
            
            if (currentRating === rating) {
                currentRating = 0;
            } else {
                currentRating = rating;
            }
            
            updateStars(currentRating);
        });
        
        star.addEventListener('mouseenter', function() {
            const hoverRating = index + 1;
            starItems.forEach((s, i) => {
                if (i < hoverRating) {
                    s.className = 'bi bi-star-fill star-rating-item';
                } else {
                    s.className = 'bi bi-star star-rating-item';
                }
            });
        });
        
        star.addEventListener('mouseleave', function() {
            updateStars(currentRating);
        });
    });
    
    const form = document.getElementById('surveyForm');
    form.addEventListener('submit', function(e) {
        const selectedScore = document.querySelector('input[name="score"]:checked');
        if (!selectedScore) {
            alert('Selecteer eerst een waardering door op de sterren te klikken.');
            e.preventDefault();
            return false;
        }
    });
    
    updateStars(currentRating);
});
</script>