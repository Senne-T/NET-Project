@{
    ViewData["Title"] = "Bedankt voor uw feedback!";
}

<style>
    .thankyou-hero {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
        padding: 2rem 0;
        margin-bottom: 2rem;
        border-radius: 0 0 1.5rem 1.5rem;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .thankyou-hero::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -10%;
        width: 500px;
        height: 500px;
        background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
        border-radius: 50%;
    }

    .thankyou-hero h1 {
        font-size: 2rem;
        margin-bottom: 0.5rem;
        position: relative;
        z-index: 1;
    }

    .thankyou-hero p {
        font-size: 1rem;
        margin-bottom: 0;
        opacity: 0.95;
        position: relative;
        z-index: 1;
    }

    .success-icon-container {
        background: white;
        width: 120px;
        height: 120px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 2rem;
        box-shadow: 0 10px 40px rgba(0,0,0,0.15);
        animation: successPulse 2s ease-in-out infinite;
    }

    .success-icon {
        font-size: 4rem;
        color: #28a745;
    }

    @@keyframes successPulse {
        0%, 100% { transform: scale(1); box-shadow: 0 10px 40px rgba(0,0,0,0.15); }
        50% { transform: scale(1.05); box-shadow: 0 15px 50px rgba(40, 167, 69, 0.3); }
    }

    .thankyou-card {
        background: white;
        border-radius: 1.5rem;
        box-shadow: 0 10px 40px rgba(0,0,0,0.1);
        overflow: hidden;
        margin-bottom: 2rem;
    }

    .thankyou-body {
        padding: 2rem;
    }

    .rating-display-section {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        padding: 2rem;
        border-radius: 1.5rem;
        margin: 2rem 0;
        text-align: center;
    }

    .rating-display-section h4 {
        color: #2d3748;
        font-weight: 700;
        margin-bottom: 1.5rem;
    }

    .star-display {
        display: flex;
        justify-content: center;
        gap: 0.5rem;
        margin: 1.5rem 0;
    }

    .star-display i {
        font-size: 3rem;
        animation: starFadeIn 0.5s ease-in-out;
        animation-fill-mode: both;
    }

    .star-display i:nth-child(1) { animation-delay: 0.1s; }
    .star-display i:nth-child(2) { animation-delay: 0.2s; }
    .star-display i:nth-child(3) { animation-delay: 0.3s; }
    .star-display i:nth-child(4) { animation-delay: 0.4s; }
    .star-display i:nth-child(5) { animation-delay: 0.5s; }

    @@keyframes starFadeIn {
        from {
            opacity: 0;
            transform: scale(0) rotate(-180deg);
        }
        to {
            opacity: 1;
            transform: scale(1) rotate(0);
        }
    }

    .rating-label {
        font-size: 1.5rem;
        font-weight: 700;
        margin-top: 1rem;
    }

    .rating-emoji {
        font-size: 4rem;
        margin: 1rem 0;
        animation: emojiPop 0.8s ease-in-out;
    }

    @@keyframes emojiPop {
        0% { transform: scale(0); }
        50% { transform: scale(1.2); }
        100% { transform: scale(1); }
    }

    .comments-section {
        background: linear-gradient(135deg, #e7f3ff 0%, #f0f9ff 100%);
        border-left: 4px solid #667eea;
        padding: 1.5rem;
        border-radius: 0.75rem;
        margin: 2rem 0;
    }

    .comments-section h5 {
        color: #667eea;
        font-weight: 700;
        margin-bottom: 1rem;
    }

    .info-box {
        background: white;
        border: 2px solid #e9ecef;
        padding: 1.5rem;
        border-radius: 1rem;
        margin: 2rem 0;
    }

    .action-buttons {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        justify-content: center;
        margin-top: 2rem;
    }

    .btn-home {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        color: white;
        font-size: 1.1rem;
        font-weight: 600;
        padding: 0.875rem 2rem;
        border-radius: 0.75rem;
        transition: all 0.3s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-home:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
        color: white;
    }

    .btn-reserve {
        background: white;
        border: 2px solid #667eea;
        color: #667eea;
        font-size: 1.1rem;
        font-weight: 600;
        padding: 0.875rem 2rem;
        border-radius: 0.75rem;
        transition: all 0.3s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-reserve:hover {
        background: #667eea;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
    }

    .thank-you-message {
        text-align: center;
        color: #2d3748;
        line-height: 1.8;
        margin: 2rem 0;
    }

    .thank-you-message h3 {
        color: #28a745;
        font-weight: 700;
        margin-bottom: 1rem;
    }

    @@media (max-width: 768px) {
        .star-display i {
            font-size: 2rem;
        }

        .success-icon-container {
            width: 100px;
            height: 100px;
        }

        .success-icon {
            font-size: 3rem;
        }

        .action-buttons {
            flex-direction: column;
        }

        .btn-home, .btn-reserve {
            width: 100%;
        }
    }
</style>

<div class="thankyou-hero">
    <div class="container">
        <h1 class="fw-bold">
            <i class="bi bi-check-circle-fill"></i> Bedankt!
        </h1>
        <p>Uw feedback is succesvol ontvangen</p>
    </div>
</div>

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            
            <div class="thankyou-card">
                <div class="thankyou-body">
                    <div class="success-icon-container">
                        <i class="bi bi-heart-fill success-icon"></i>
                    </div>

                    <div class="thank-you-message">
                        <h3>Uw mening is voor ons van groot belang!</h3>
                        <p class="lead">
                            Hartelijk dank voor het invullen van onze klanttevredenheid enquête.
                            Uw feedback helpt ons om onze service continu te verbeteren.
                        </p>
                    </div>

                    <div class="rating-display-section">
                        <h4>Uw waardering</h4>
                        
                        @{
                            int score = (int)ViewBag.Score;
                            string emoji = score switch {
                                5 => "&#128525;",
                                4 => "&#128522;",
                                3 => "&#128528;",
                                2 => "&#128533;",
                                1 => "&#128542;",
                                _ => "&#11088;"
                            };
                            string label = score switch {
                                5 => "Uitstekend",
                                4 => "Goed",
                                3 => "Voldoende",
                                2 => "Onder verwachting",
                                1 => "Teleurstellend",
                                _ => "Onbekend"
                            };
                            string color = score switch {
                                5 => "#28a745",
                                4 => "#20c997",
                                3 => "#ffc107",
                                2 => "#fd7e14",
                                1 => "#dc3545",
                                _ => "#6c757d"
                            };
                        }

                        <div class="rating-emoji">@Html.Raw(emoji)</div>

                        <div class="star-display">
                            @for (int i = 0; i < 5; i++)
                            {
                                if (i < score)
                                {
                                    <i class="bi bi-star-fill text-warning"></i>
                                }
                                else
                                {
                                    <i class="bi bi-star text-muted"></i>
                                }
                            }
                        </div>

                        <div class="rating-label" style="color: @color">
                            @label (@score ster@(score != 1 ? "ren" : ""))
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(ViewBag.Opmerkingen))
                    {
                        <div class="comments-section">
                            <h5>
                                <i class="bi bi-chat-left-quote-fill me-2"></i>
                                Uw opmerkingen
                            </h5>
                            <p class="mb-0">@ViewBag.Opmerkingen</p>
                        </div>
                    }

                    <div class="info-box">
                        <div class="text-center">
                            <i class="bi bi-info-circle text-primary" style="font-size: 2rem;"></i>
                            <p class="mt-3 mb-0">
                                <strong>Heeft u nog vragen of opmerkingen?</strong><br>
                                Neem gerust contact met ons op via <a href="mailto:info@chezantoine.be">info@chezantoine.be</a>
                            </p>
                        </div>
                    </div>

                    <div class="action-buttons">
                        <a href="@Url.Action("Index", "Home")" class="btn-home">
                            <i class="bi bi-house-door-fill"></i>
                            Terug naar Home
                        </a>
                        <a href="@Url.Action("Index", "Reservatie")" class="btn-reserve">
                            <i class="bi bi-calendar-check-fill"></i>
                            Nieuwe Reservatie
                        </a>
                    </div>
                </div>
            </div>

            <div class="text-center text-muted mt-4">
                <small>
                    <i class="bi bi-shop-window me-2"></i>
                    Restaurant Chez Antoine - Kwaliteit en gastvrijheid
                </small>
            </div>
        </div>
    </div>
</div>