@model Restaurant.ViewModels.ProductCreateViewModel

@{
    ViewData["Title"] = "Nieuw dessert";
}

<h2>Nieuw dessert</h2>

<form asp-action="Create" method="post" class="mt-3">

    <div class="mb-3">
        <label asp-for="Naam" class="form-label"></label>
        <input asp-for="Naam" class="form-control" />
        <span asp-validation-for="Naam" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Beschrijving" class="form-label"></label>
        <textarea asp-for="Beschrijving" rows="3" class="form-control"></textarea>
        <span asp-validation-for="Beschrijving" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="AllergenenInfo" class="form-label"></label>
        <input asp-for="AllergenenInfo" class="form-control" />
        <span asp-validation-for="AllergenenInfo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CategorieId" class="form-label">Categorie</label>
        <select asp-for="CategorieId" asp-items="Model.Categorieën" class="form-select"></select>
        <span asp-validation-for="CategorieId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Prijs" class="form-label"></label>
        <input asp-for="Prijs" class="form-control" type="number" step="0.01" lang="en" inputmode="decimal" />
        <span asp-validation-for="Prijs" class="text-danger"></span>
    </div>

    <div class="form-check mb-2">
        <input asp-for="Actief" class="form-check-input" />
        <label asp-for="Actief" class="form-check-label"></label>
    </div>

    <div class="form-check mb-4">
        <input asp-for="IsSuggestie" class="form-check-input" />
        <label asp-for="IsSuggestie" class="form-check-label">Suggestie</label>
    </div>

    <button type="submit" class="btn btn-primary">Opslaan</button>
    <a asp-action="Index" class="btn btn-secondary">Annuleren</a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
