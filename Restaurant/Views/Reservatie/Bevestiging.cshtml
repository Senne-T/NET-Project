@{
    ViewData["Title"] = "Reservatie Bevestiging";
}

<style>
    .confirmation-hero {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 2rem 0;
        margin-bottom: 2rem;
        border-radius: 0 0 1.5rem 1.5rem;
        text-align: center;
    }

    .success-icon {
        font-size: 4rem;
        color: #28a745;
        background: white;
        border-radius: 50%;
        width: 100px;
        height: 100px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
        box-shadow: 0 5px 20px rgba(0,0,0,0.15);
        animation: bounce 0.8s ease;
    }

    @@keyframes bounce {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.1); }
    }

    .confirmation-title {
        font-size: 2rem;
        font-weight: bold;
    }

    .info-card {
        background: white;
        border-radius: 1rem;
        box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        overflow: hidden;
        margin-bottom: 1.5rem;
    }

    .info-section {
        padding: 1.25rem;
        border-bottom: 1px solid #e9ecef;
    }

    .info-section:last-child {
        border-bottom: none;
    }

    .info-section h5 {
        color: #667eea;
        font-weight: 700;
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1.1rem;
    }

    .next-steps {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .next-steps li {
        padding: 0.75rem;
        margin-bottom: 0.5rem;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-radius: 0.5rem;
        border-left: 3px solid #667eea;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .next-steps li i {
        font-size: 1.25rem;
        color: #667eea;
    }

    .feature-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin-top: 1rem;
    }

    .feature-card {
        text-align: center;
        padding: 1rem;
        background: white;
        border-radius: 0.75rem;
        border: 2px solid #e9ecef;
    }

    .feature-card i {
        font-size: 2rem;
        color: #667eea;
        margin-bottom: 0.5rem;
    }

    .feature-card h6 {
        font-weight: 600;
        margin-bottom: 0.25rem;
        font-size: 0.95rem;
    }

    .feature-card p {
        font-size: 0.85rem;
        color: #718096;
        margin: 0;
    }

    .reminder-box {
        background: linear-gradient(135deg, #fff3cd 0%, #fffbea 100%);
        border-left: 3px solid #ffc107;
        padding: 1rem;
        border-radius: 0.5rem;
        margin-top: 1.5rem;
        text-align: center;
    }

    .action-buttons {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-top: 1.5rem;
    }

    .btn-home, .btn-new-reservation {
        flex: 1;
        min-width: 200px;
        font-size: 1rem;
        font-weight: 600;
        padding: 0.75rem 1.5rem;
        border-radius: 0.5rem;
    }

    .btn-home {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        color: white;
    }

    .btn-new-reservation {
        background: white;
        border: 2px solid #667eea;
        color: #667eea;
    }
</style>

<div class="confirmation-hero">
    <div class="success-icon">
        <i class="bi bi-check-circle-fill"></i>
    </div>
    <h1 class="confirmation-title">Reservatie Bevestigd!</h1>
    <p>Bedankt voor uw reservatie</p>
</div>

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    <strong>@TempData["SuccessMessage"]</strong>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="info-card">
                <div class="info-section">
                    <h5>
                        <i class="bi bi-envelope-check-fill"></i>
                        Bevestigingsmail
                    </h5>
                    <p class="mb-0">
                        U ontvangt een bevestigingsmail met alle details.
                    </p>
                </div>

                <div class="info-section">
                    <h5>
                        <i class="bi bi-list-check"></i>
                        Volgende Stappen
                    </h5>
                    <ul class="next-steps">
                        <li>
                            <i class="bi bi-envelope"></i>
                            <div>
                                <strong>Check uw e-mail</strong>
                                <div class="text-muted small">Bevestiging met details</div>
                            </div>
                        </li>
                        <li>
                            <i class="bi bi-calendar-check"></i>
                            <div>
                                <strong>Noteer datum en tijd</strong>
                                <div class="text-muted small">Voeg toe aan agenda</div>
                            </div>
                        </li>
                        <li>
                            <i class="bi bi-person-check"></i>
                            <div>
                                <strong>10 min voor aanvang</strong>
                                <div class="text-muted small">Optimale ontvangst</div>
                            </div>
                        </li>
                    </ul>
                </div>

                <div class="info-section">
                    <h5>
                        <i class="bi bi-info-circle-fill"></i>
                        Informatie
                    </h5>
                    <div class="feature-grid">
                        <div class="feature-card">
                            <i class="bi bi-clock"></i>
                            <h6>Openingstijden</h6>
                            <p>Di–Zo 11:30–22:00</p>
                        </div>
                        <div class="feature-card">
                            <i class="bi bi-geo-alt"></i>
                            <h6>Locatie</h6>
                            <p>Turnhout, België</p>
                        </div>
                        <div class="feature-card">
                            <i class="bi bi-telephone"></i>
                            <h6>Contact</h6>
                            <p>Bij vragen bel ons</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="reminder-box">
                <i class="bi bi-exclamation-triangle-fill text-warning d-block mb-2" style="font-size: 1.5rem;"></i>
                <strong>Belangrijke Herinnering</strong>
                <p class="mb-0 mt-1 small">
                    Annuleer tijdig via "Mijn Reservaties" indien u niet kunt komen.
                </p>
            </div>

            <div class="action-buttons">
                <a asp-controller="Home" asp-action="Index" class="btn-home">
                    <i class="bi bi-house-door-fill"></i>
                    Terug naar Home
                </a>
                <a asp-controller="Reservatie" asp-action="MyReservations" class="btn-new-reservation">
                    <i class="bi bi-list-check"></i>
                    Mijn Reservaties
                </a>
            </div>
        </div>
    </div>
</div>
